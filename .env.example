# Copy to .env and fill in. Placeholders only — never commit real values.

# ── Control plane (apps/web) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Set to 1 to show "Continue with GitHub" on the sign-in page (enable GitHub in Supabase Auth first).
NEXT_PUBLIC_SUPABASE_GITHUB=
# Public URL the runners call back to (heartbeats).
LEMONLIME_PUBLIC_URL=http://localhost:3000
# Secret used to sign runner tokens (at least 16 characters). Generate with: openssl rand -hex 32
LEMONLIME_TOKEN_SECRET=replace-with-a-long-random-string
# Secret the scheduler sends to /api/cron/* routes.
LEMONLIME_CRON_SECRET=replace-with-a-long-random-string

# Which sandbox provider to use for cloud threads: docker | daytona | e2b
LEMONLIME_SANDBOX_PROVIDER=docker
# Container image that has the runner and agent CLIs installed.
LEMONLIME_SANDBOX_IMAGE=lemonlime/sandbox:latest

# Optional plugin module that provides UsagePolicy / BillingUI hooks.
# Leave empty to allow everything (the default for self-hosting).
LEMONLIME_PLUGIN=

# ── Sandbox providers (only the one you use) ─────────────
DAYTONA_API_KEY=your-daytona-api-key
DAYTONA_API_URL=https://app.daytona.io/api
E2B_API_KEY=your-e2b-api-key
# E2B templates built from docker/sandbox.Dockerfile, one per sandbox size.
E2B_TEMPLATE_SMALL=your-small-template
E2B_TEMPLATE_LARGE=your-large-template

# ── Runner ───────────────────────────────────────────────
LEMONLIME_RUNNER_PORT=7420

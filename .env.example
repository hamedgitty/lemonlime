# Copy to apps/web/.env.local (Node) or apps/web/.dev.vars (wrangler dev) and fill in.
# Placeholders only — never commit real values. On Cloudflare Workers, set secrets
# with `wrangler secret put <NAME>` and plain settings under "vars" in apps/web/wrangler.jsonc.

# ── Control plane (apps/web) ─────────────────────────────
# Public URL of the control plane. Sign-in links, cookies and runner heartbeats use it.
LEMONLIME_PUBLIC_URL=http://localhost:3000
# Secret used to sign sessions (Better Auth). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-string
# Secret used to sign runner tokens (at least 16 characters). Generate with: openssl rand -hex 32
LEMONLIME_TOKEN_SECRET=replace-with-a-long-random-string
# Secret the scheduler sends to /api/cron/sweep (Node deployments; Workers use a cron trigger).
LEMONLIME_CRON_SECRET=replace-with-a-long-random-string

# SQLite database for Node deployments (ignored on Workers, which use the D1 binding "DB").
LEMONLIME_DATABASE_URL=file:./data/lemonlime.db

# ── Sign-in email ────────────────────────────────────────
# Sender of sign-in codes. Its domain must be verified with your email provider.
LEMONLIME_EMAIL_FROM=LemonLime <sign-in@example.com>
# Used when there is no Cloudflare Email Service binding (EMAIL). Leave empty in
# development to print codes to the server console instead.
RESEND_API_KEY=

# ── Optional GitHub sign-in ──────────────────────────────
# OAuth app callback URL: <LEMONLIME_PUBLIC_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Sandboxes ────────────────────────────────────────────
# Which sandbox provider to use for cloud threads: docker | daytona | e2b
# (docker needs a Node deployment on the same host as Docker).
LEMONLIME_SANDBOX_PROVIDER=docker
# Container image that has the runner and agent CLIs installed.
LEMONLIME_SANDBOX_IMAGE=lemonlime/sandbox:latest
# Docker provider behind a reverse proxy (compose.yaml sets these for you): the network
# sandboxes join, and the public base URL runners are reached under.
LEMONLIME_DOCKER_NETWORK=
LEMONLIME_DOCKER_PUBLIC_URL=
# Where runners send heartbeats, if not LEMONLIME_PUBLIC_URL (e.g. http://web:3000).
LEMONLIME_RUNNER_CONTROL_PLANE_URL=
# compose.yaml only: your domain for automatic HTTPS, or :80 for plain HTTP.
LEMONLIME_SITE_ADDRESS=:80

# Sandbox providers (only the one you use)
DAYTONA_API_KEY=your-daytona-api-key
DAYTONA_API_URL=https://app.daytona.io/api
# Optional: start Daytona sandboxes from a prebuilt snapshot instead of building the image each time (faster).
DAYTONA_SNAPSHOT=
E2B_API_KEY=your-e2b-api-key
# E2B templates built from docker/sandbox.Dockerfile, one per sandbox size.
E2B_TEMPLATE_SMALL=your-small-template
E2B_TEMPLATE_LARGE=your-large-template

# ── Runner ───────────────────────────────────────────────
LEMONLIME_RUNNER_PORT=7420

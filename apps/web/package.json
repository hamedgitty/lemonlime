{
  "name": "@lemonlime/web",
  "version": "0.1.0",
  "private": true,
  "description": "LemonLime control plane: auth, threads, sandbox provisioning, tokens and dashboard. Runs on Cloudflare Workers + D1 or any Node server.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@lemonlime/client": "workspace:*",
    "@lemonlime/db": "workspace:*",
    "@lemonlime/deployment-plugin": "workspace:*",
    "@lemonlime/plugins": "workspace:*",
    "@lemonlime/protocol": "workspace:*",
    "@lemonlime/sandbox": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@opennextjs/cloudflare": "^1.20.16",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.69.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "wrangler": "^4.158.0"
  }
}

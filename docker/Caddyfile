# Reverse proxy for self-hosting with compose.yaml, and the only way in or out of the
# sandbox network.
#
# Public site: the dashboard, plus each cloud thread's runner under
# /sandbox/<container>/, so apps reach runners over the same HTTPS address. Only the
# runner's WebSockets (thread and terminal), health check, capabilities and attachment
# uploads are passed through, from containers named
# lemonlime-<thread id> on the runner port. Code in a sandbox controls what its port
# serves, so nothing else from it may reach a browser on the dashboard's origin.
#
# :8080 (sandbox network only): runners reach the dashboard's runner API through here,
# never directly, so the address the dashboard sees is the sandbox's own.
#
# LEMONLIME_SITE_ADDRESS: your domain (e.g. lemonlime.example.com) for automatic HTTPS,
# or :80 for plain HTTP on a private network.
{$LEMONLIME_SITE_ADDRESS::80} {
	encode zstd gzip

	@runner path_regexp runner ^/sandbox/(lemonlime-[a-z0-9][a-z0-9-]{5,63})(/ws|/terminal|/healthz|/capabilities|/attachments(?:/[A-Za-z0-9_-]{8,64})?)$
	handle @runner {
		rewrite * {re.runner.2}
		reverse_proxy {re.runner.1}:7420 {
			# Even if something else answers on the port, the browser treats it as an
			# opaque, script-less page.
			header_down Content-Security-Policy "sandbox; default-src 'none'"
			header_down X-Content-Type-Options nosniff
			header_down -Set-Cookie
		}
	}

	@otherSandbox path /sandbox/*
	handle @otherSandbox {
		respond 404
	}

	handle {
		reverse_proxy web:3000
	}
}

:8080 {
	@runnerApi path /api/runner/*
	handle @runnerApi {
		reverse_proxy web:3000
	}
	handle {
		respond 404
	}
}

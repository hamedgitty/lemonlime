{
  "name": "@lemonlime/runner",
  "version": "0.1.0",
  "description": "Daemon that runs next to one coding agent, streams its events and keeps its history.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lemonlime-runner": "./bin/lemonlime-runner.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "record": "tsx scripts/record-fixture.ts",
    "build:sea": "node scripts/build-sea.mjs"
  },
  "dependencies": {
    "@lemonlime/protocol": "workspace:*",
    "@lydell/node-pty": "1.1.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@lemonlime/client": "workspace:*",
    "@types/ws": "^8.18.2",
    "esbuild": "0.25.12",
    "postject": "1.0.0-alpha.6"
  }
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main LemonLime window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-badge-count",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-unminimize",
    "dialog:allow-open",
    "dialog:allow-ask",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*"
        },
        {
          "url": "http://*:*"
        },
        {
          "url": "https://*"
        },
        {
          "url": "https://*:*"
        }
      ]
    },
    "deep-link:default",
    "updater:default",
    "notification:default"
  ]
}

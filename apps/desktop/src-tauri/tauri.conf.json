{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LemonLime",
  "version": "0.2.1",
  "identifier": "org.lemonlime.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "LemonLime",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 580,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 22,
          "y": 27
        }
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:* ws://localhost:* http: https: ws: wss:",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "media-src": "'self' blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "frame-src": "http://127.0.0.1:* http://localhost:* blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'self'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Run coding agents on your computer or in cloud sandboxes.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "createUpdaterArtifacts": true,
    "macOS": { "entitlements": "Entitlements.plist", "hardenedRuntime": true, "minimumSystemVersion": "13.3" },
    "externalBin": ["binaries/lemonlime-runner"],
    "resources": {
      "../../../packages/runner/skills/": "skills/",
      "binaries/node-pty/": "node-pty/"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["lemonlime"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBNUY2ODdBMTE4QkREMTYKUldRVzNZc1JlbWhmNnJYSDNSTjVrdStiVzBKdy9KS2F6clZmRG95TG9jQ21nQVZKRnNoYWNLRTkK",
      "endpoints": ["https://github.com/hamedgitty/lemonlime/releases/latest/download/latest.json"]
    }
  }
}
